<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The sandbox lives outside Assets/ so Unity never compiles it. -->
    <RootNamespace>CruceChaos.Sandbox</RootNamespace>
    <AssemblyName>CruceChaos.Sandbox</AssemblyName>
  </PropertyGroup>

  <!--
    Share the pure-C# Core source with the Unity project instead of copying it.
    These <Compile Include> globs pull the SAME .cs files that Unity compiles
    under Assets/_Project/Scripts/Core, so there is one source of truth and no
    drift. The files physically live under Assets/; we just link them here.
    (We deliberately link only Core/ — nothing that imports UnityEngine.)
  -->
  <ItemGroup>
    <Compile Include="..\Assets\_Project\Scripts\Core\**\*.cs">
      <Link>Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
